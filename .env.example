# Configuración General del Entorno UV
NODE_ENV=production
PORT=4000

# Seguridad & Autenticación Federada Azure AD / UV
JWT_SECRET=uv_jwt_secret_token_alpha_testing_2026
VITE_JWT_SECRET=uv_jwt_secret_token_alpha_testing_2026
SESSION_TTL_SECONDS=28800
TRANSACTION_WINDOW_SECONDS=600

# Base de Datos PostgreSQL 16 (Opcional para servicios backend)
POSTGRES_USER=uv_admin
POSTGRES_PASSWORD=uv_password_2026
POSTGRES_DB=uv_academic_db
DATABASE_URL=postgresql://uv_admin:uv_password_2026@localhost:5432/uv_academic_db

# Caché y Sala de Espera Redis 7 (Opcional para servicios backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=uv_redis_secret
REDIS_URL=redis://:uv_redis_secret@localhost:6379

# Frontend URL & API Endpoints
VITE_API_URL=http://localhost:4000
